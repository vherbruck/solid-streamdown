{
  "name": "solid-streamdown-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "bun run --filter './packages/*' build && bun run --filter './examples/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test:types": "bun run --filter './packages/*' test:types",
    "test": "bun run --filter './packages/*' test && bun test ./scripts",
    "docs:check": "node scripts/check-docs.mjs",
    "test:e2e": "playwright test",
    "docs:sync": "node scripts/check-docs.mjs --write",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "^29.0.1",
    "solid-js": "1.9.17",
    "tsup": "^8.4.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.8.2",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.1.12"
  }
}
