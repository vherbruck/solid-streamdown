{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The plugin packages' types come from their source, as in vitest.config.ts,
    // so typechecking does not depend on a prior build.
    "paths": {
      "@solid-streamdown/cjk": ["../streamdown-cjk/index.ts"],
      "@solid-streamdown/code": ["../streamdown-code/index.ts"],
      "@solid-streamdown/math": ["../streamdown-math/index.ts"],
      "@solid-streamdown/mermaid": ["../streamdown-mermaid/index.ts"]
    }
  },
  "include": ["index.tsx", "lib/**/*", "hooks/**/*", "__tests__/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
