{
  "name": "solid-streamdown",
  "version": "1.0.1",
  "description": "Streaming Markdown renderer for SolidJS, a port of Vercel's Streamdown",
  "type": "module",
  "license": "Apache-2.0",
  "author": "vherbruck",
  "repository": {
    "type": "git",
    "url": "https://github.com/vherbruck/solid-streamdown",
    "directory": "packages/streamdown"
  },
  "keywords": ["solid", "solidjs", "markdown", "streaming", "ai", "chat", "llm"],
  "files": ["dist", "styles.css", "LICENSE", "NOTICE", "README.md"],
  "main": "./dist/server.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/server.js": "./dist/index.js"
  },
  "exports": {
    ".": {
      "solid": {
        "development": "./dist/dev.jsx",
        "import": "./dist/index.jsx"
      },
      "development": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/dev.js"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/server.js"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
